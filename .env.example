# Modelo ilustrativo. Nunca coloque valores reais neste arquivo.
# Configure os valores reais apenas no ambiente seguro de execução.

APP_ENV=development
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# RPC Arbitrum; use endpoint protegido/gerenciado.
ARBITRUM_RPC_URL=

# Configuração pública do frontend; não inserir chave privada.
NEXT_PUBLIC_APP_NAME=FMT QUANTUM
NEXT_PUBLIC_CHAIN_ID=42161
GMX_CHAIN_ID=42161
BYBIT_ENV=production
BYBIT_API_BASE_URL=https://api.bybit.com
EXECUTION_ENABLED=false
MAX_PRICE_DIVERGENCE_BPS=30

# Segredos de sessão/autenticação devem ser gerados e armazenados
# no gerenciador de segredos do ambiente.
SESSION_SECRET=

# Rust API
API_BIND=127.0.0.1:8080
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
